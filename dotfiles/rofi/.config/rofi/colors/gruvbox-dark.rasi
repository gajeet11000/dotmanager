/* rofi color palette -- Gruvbox Dark. `mauve` (the accent used for the
   selected-item highlight) matches active_border_color in
   dotfiles/kitty/.config/kitty/themes/gruvbox-dark.conf for cross-app
   consistency. Role names follow the Catppuccin naming convention the
   original template used; application_launcher.rasi and
   window_switcher.rasi only actually reference a subset of these
   (base, text, mauve, red, overlay0, blue, flamingo) -- the rest exist
   for parity/future use. */
* {
  flamingo-mauve-gradient: linear-gradient(45deg, #fe8019, #d79921);
  rosewater 	: rgba(214, 93, 14, 1.0);
  flamingo 	: rgba(254, 128, 25, 1.0);
  pink 	: rgba(211, 134, 155, 1.0);
  mauve 	: rgba(215, 153, 33, 1.0);
  red 	: rgba(251, 73, 52, 1.0);
  maroon 	: rgba(204, 36, 29, 1.0);
  peach 	: rgba(254, 128, 25, 1.0);
  yellow 	: rgba(250, 189, 47, 1.0);
  green 	: rgba(184, 187, 38, 1.0);
  teal 	: rgba(142, 192, 124, 1.0);
  sky 	: rgba(142, 192, 124, 1.0);
  sapphire 	: rgba(69, 133, 136, 1.0);
  blue 	: rgba(131, 165, 152, 1.0);
  lavender 	: rgba(211, 134, 155, 1.0);
  text 	: rgba(235, 219, 178, 1.0);
  subtext1 	: rgba(213, 196, 161, 1.0);
  subtext0 	: rgba(189, 174, 147, 1.0);
  overlay2 	: rgba(168, 153, 132, 1.0);
  overlay1 	: rgba(146, 131, 116, 1.0);
  overlay0 	: rgba(124, 111, 100, 1.0);
  surface2 	: rgba(102, 92, 84, 1.0);
  surface1 	: rgba(80, 73, 69, 1.0);
  surface0 	: rgba(60, 56, 54, 1.0);
  base 	: rgba(40, 40, 40, 1.0);
  mantle 	: rgba(29, 32, 33, 1.0);
  crust 	: rgba(29, 32, 33, 1.0);
}
