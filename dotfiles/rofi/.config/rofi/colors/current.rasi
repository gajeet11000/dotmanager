/* rofi color palette -- Catppuccin Macchiato (mauve accent). This is the
   real official Macchiato palette (the old colors/mocha.rasi this
   replaces was actually the wrong Catppuccin flavour -- Mocha, not
   Macchiato -- for what this theme is supposed to be). `mauve` matches
   active_border_color in
   dotfiles/kitty/.config/kitty/themes/catppuccin-macchiato-mauve.conf. */
* {
  flamingo-mauve-gradient: linear-gradient(45deg, #f0c6c6, #c6a0f6);
  rosewater 	: rgba(244, 219, 214, 1.0);
  flamingo 	: rgba(240, 198, 198, 1.0);
  pink 	: rgba(245, 189, 230, 1.0);
  mauve 	: rgba(198, 160, 246, 1.0);
  red 	: rgba(237, 135, 150, 1.0);
  maroon 	: rgba(238, 153, 160, 1.0);
  peach 	: rgba(245, 169, 127, 1.0);
  yellow 	: rgba(238, 212, 159, 1.0);
  green 	: rgba(166, 218, 149, 1.0);
  teal 	: rgba(139, 213, 202, 1.0);
  sky 	: rgba(145, 215, 227, 1.0);
  sapphire 	: rgba(125, 196, 228, 1.0);
  blue 	: rgba(138, 173, 244, 1.0);
  lavender 	: rgba(183, 189, 248, 1.0);
  text 	: rgba(202, 211, 245, 1.0);
  subtext1 	: rgba(184, 192, 224, 1.0);
  subtext0 	: rgba(165, 173, 203, 1.0);
  overlay2 	: rgba(147, 154, 183, 1.0);
  overlay1 	: rgba(128, 135, 162, 1.0);
  overlay0 	: rgba(110, 115, 141, 1.0);
  surface2 	: rgba(91, 96, 120, 1.0);
  surface1 	: rgba(73, 77, 100, 1.0);
  surface0 	: rgba(54, 58, 79, 1.0);
  base 	: rgba(36, 39, 58, 1.0);
  mantle 	: rgba(30, 32, 48, 1.0);
  crust 	: rgba(24, 25, 38, 1.0);
}
