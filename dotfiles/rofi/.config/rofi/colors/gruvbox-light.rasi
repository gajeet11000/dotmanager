/* rofi color palette -- Gruvbox Light. `mauve` (the accent used for the
   selected-item highlight) matches active_border_color in
   dotfiles/kitty/.config/kitty/themes/gruvbox-light.conf for cross-app
   consistency. Role names follow the Catppuccin naming convention the
   original template used; application_launcher.rasi and
   window_switcher.rasi only actually reference a subset of these
   (base, text, mauve, red, overlay0, blue, flamingo) -- the rest exist
   for parity/future use. */
* {
  flamingo-mauve-gradient: linear-gradient(45deg, #d65d0e, #b57614);
  rosewater 	: rgba(175, 58, 3, 1.0);
  flamingo 	: rgba(214, 93, 14, 1.0);
  pink 	: rgba(143, 63, 113, 1.0);
  mauve 	: rgba(181, 118, 20, 1.0);
  red 	: rgba(157, 0, 6, 1.0);
  maroon 	: rgba(204, 36, 29, 1.0);
  peach 	: rgba(214, 93, 14, 1.0);
  yellow 	: rgba(181, 118, 20, 1.0);
  green 	: rgba(121, 116, 14, 1.0);
  teal 	: rgba(66, 123, 88, 1.0);
  sky 	: rgba(66, 123, 88, 1.0);
  sapphire 	: rgba(7, 102, 120, 1.0);
  blue 	: rgba(7, 102, 120, 1.0);
  lavender 	: rgba(143, 63, 113, 1.0);
  text 	: rgba(60, 56, 54, 1.0);
  subtext1 	: rgba(80, 73, 69, 1.0);
  subtext0 	: rgba(102, 92, 84, 1.0);
  overlay2 	: rgba(124, 111, 100, 1.0);
  overlay1 	: rgba(146, 131, 116, 1.0);
  overlay0 	: rgba(168, 153, 132, 1.0);
  surface2 	: rgba(189, 174, 147, 1.0);
  surface1 	: rgba(213, 196, 161, 1.0);
  surface0 	: rgba(235, 219, 178, 1.0);
  base 	: rgba(251, 241, 199, 1.0);
  mantle 	: rgba(249, 245, 215, 1.0);
  crust 	: rgba(249, 245, 215, 1.0);
}
